{
  "name": "obsidian-summairize",
  "version": "0.1.0",
  "description": "AI-powered note summarization plugin for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "ai",
    "summarization",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "1.7.2",
    "tslib": "2.4.0",
    "typescript": "5.5.4",
    "vitest": "^3.0.0"
  }
}
